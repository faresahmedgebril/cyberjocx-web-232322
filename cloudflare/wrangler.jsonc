{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "cyberjocx-api",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_NEON_HYPERDRIVE_ID"
    }
  ]
}
